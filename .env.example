# Copie a .env y ajuste. Todos son opcionales.
PLD_UPDATE_EVERY_H=6
# Con 'serve' la página actualiza OFAC/ONU/SAT sola cada PLD_UPDATE_EVERY_H horas. Ponga 0 para apagarlo
# (Docker ya lo maneja con el servicio worker).
# PLD_AUTO_UPDATE=1
# Umbrales de coincidencia (0-100)
PLD_TH_ALTA=93
PLD_TH_MEDIA=85
PLD_TH_BAJA=78
# Nivel mínimo que genera alerta formal: BAJA | MEDIA | ALTA
PLD_ALERT_MIN_LEVEL=MEDIA
# Plazos internos de atención (horas) – validar con su Oficial de Cumplimiento / asesor legal
PLD_SLA_CRITICA_H=24
PLD_SLA_REVISION_H=72
# Rechaza una lista nueva si trae menos de esta fracción de los registros actuales (archivo truncado)
PLD_MIN_SHRINK_RATIO=0.5
# Las URLs oficiales cambian: verifíquelas y ajústelas aquí si hace falta
# PLD_URL_OFAC_SDN=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV
# PLD_URL_OFAC_ALT=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/ALT.CSV
# PLD_URL_UN=https://scsanctions.un.org/resources/xml/en/consolidated.xml
# PLD_URL_SAT_69B=https://wu1agsprosta001.blob.core.windows.net/agsc-publicaciones/Datos_abiertos/Documents_AGAFF/Listado_completo_69-B.csv

# Nombre que aparece en las constancias impresas (opcional)
# PLD_ORG_NAME=Notaría Pública No. 12, Lic. Nombre Apellido

# --- Producción (docker-compose.prod.yml) ---
# Dominio apuntando a su servidor (registro DNS tipo A). Caddy emite el certificado HTTPS automáticamente.
DOMAIN=pld.sunotaria.mx
# (Docker ya define la ruta de country_risk.csv dentro del volumen; no la cambie)
# Las listas se descargan solas a PLD_UPDATE_EVERY_H horas

# --- Proveedor externo de PEP/sanciones por API (opcional) ---
# none | mock (datos ficticios, sin clave) | opensanctions | dilisense
PLD_EXT_PROVIDER=none
PLD_EXT_API_KEY=

# Demo para prospectos (registro público desde la página de inicio de sesión)
PLD_REGISTRO_ABIERTO=1        # 0 = cierra el formulario de registro
PLD_DEMO_DIAS=2               # duración de la demo
PLD_DEMO_CONSULTAS=20         # consultas incluidas en la demo
PLD_CONTACTO_VENTAS=          # texto que ven los prospectos al vencer la demo (correo o teléfono)

# Recuperación del administrador desde la pantalla de inicio (opcional). Mínimo 16 caracteres; guárdelo en un lugar seguro.
PLD_RECOVERY_CODE=
