+        sql += " ORDER BY s.id DESC LIMIT ? OFFSET ?"
+        p += [max(1, min(limit, 1000)), max(0, offset)]
+        with self.lock:
+            rows = self.conn.execute(sql, p).fetchall()
+        out = []
